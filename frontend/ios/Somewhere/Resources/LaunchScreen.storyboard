                            <color key="tintColor" red="0.9608" green="0.9569" blue="0.9451" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                            <constraints><constraint firstAttribute="width" constant="45" id="mark-width"/><constraint firstAttribute="height" constant="45" id="mark-height"/></constraints>
