IPHONEOS_DEPLOYMENT_TARGET = 17.0
SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
CLANG_ENABLE_MODULES = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Config/Info.plist
SOMEWHERE_LINK_SCHEME = group-planning-ios
SOMEWHERE_YANDEX_CLIENT_ID = 43a1ba4507214901a5c08a0d090c6e30
SOMEWHERE_YANDEX_WEB_ONLY = NO
CODE_SIGN_ENTITLEMENTS = Config/Somewhere.entitlements
INFOPLIST_KEY_SomewhereLinkScheme = $(SOMEWHERE_LINK_SCHEME)
INFOPLIST_KEY_CFBundleDisplayName = somewhere
SOMEWHERE_API_ORIGIN =
SOMEWHERE_INVITATION_HOST = smwhere.ru
INFOPLIST_KEY_SomewhereAPIOrigin = $(SOMEWHERE_API_ORIGIN)
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UILaunchStoryboardName = LaunchScreen
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
PRODUCT_BUNDLE_IDENTIFIER = dev.groupplanning.ios
PRODUCT_NAME = Somewhere
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
CODE_SIGN_STYLE = Automatic
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks

#include? "Local.xcconfig"
