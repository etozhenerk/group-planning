{
  "name": "@somewhere/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "architecture": "tsx scripts/check-architecture.ts",
    "format": "prettier --write . && eslint . --fix && tsx scripts/check-styles.ts --fix && prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "build:demo": "npm run typecheck && vite build --mode demo",
    "check": "npm run typecheck && npm run lint && npm run styles && npm run architecture && npm run format:check && npm test",
    "test:e2e": "npm run build:demo && playwright test",
    "demo": "npm run build:demo && tsx scripts/browser-server.ts",
    "styles": "tsx scripts/check-styles.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "@tanstack/react-query": "5.104.5",
    "zod": "4.6.7",
    "lucide-react": "1.60.0",
    "@js-temporal/polyfill": "0.5.1",
    "@gravity-ui/uikit": "7.51.1",
    "@gravity-ui/date-components": "4.1.0",
    "@gravity-ui/date-utils": "2.7.2"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.1",
    "tsx": "4.23.15",
    "eslint": "10.13.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "@types/node": "22.20.5",
    "@stylistic/eslint-plugin": "5.10.0",
    "postcss": "8.5.31"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
