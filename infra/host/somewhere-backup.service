[Unit]
Description=Encrypted somewhere PostgreSQL backup to Object Storage
After=network-online.target postgresql@16-main.service
Wants=network-online.target
Requires=postgresql@16-main.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/usr/local/lib/somewhere/backup.py
UMask=0077
TimeoutStartSec=20min
MemoryMax=256M
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/somewhere-backup
