[Unit]
Description=Private PostgreSQL and backup metrics for somewhere
After=postgresql@16-main.service

[Service]
User=somewhere_metrics
Group=somewhere_metrics
SupplementaryGroups=postgres
ExecStart=/usr/local/lib/somewhere/postgres-metrics.py
Restart=on-failure
RestartSec=5
MemoryMax=64M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET

[Install]
WantedBy=multi-user.target
