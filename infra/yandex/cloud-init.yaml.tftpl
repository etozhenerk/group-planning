#cloud-config
${yamlencode({
  package_update = true
  packages = ["ca-certificates", "curl", "jq", "unattended-upgrades"]
  ssh_pwauth = false
  disable_root = true
  users = [
    {
      name = "somewhere-admin"
      groups = ["sudo"]
      shell = "/bin/bash"
      lock_passwd = true
      sudo = ["ALL=(ALL) NOPASSWD:ALL"]
      ssh_authorized_keys = [admin_ssh_public_key]
    },
    {
      name = "somewhere"
      system = true
      shell = "/usr/sbin/nologin"
      lock_passwd = true
      no_create_home = true
    }
  ]
  write_files = [
    {
      path = "/etc/ssh/sshd_config.d/00-somewhere.conf"
      permissions = "0644"
      content = "PasswordAuthentication no\nKbdInteractiveAuthentication no\nPermitRootLogin no\n"
    },
    {
      path = "/etc/systemd/journald.conf.d/somewhere.conf"
      permissions = "0644"
      content = "[Journal]\nSystemMaxUse=256M\nRuntimeMaxUse=64M\nMaxRetentionSec=14day\n"
    },
    {
      path = "/etc/apt/apt.conf.d/20auto-upgrades"
      permissions = "0644"
      content = "APT::Periodic::Update-Package-Lists \"1\";\nAPT::Periodic::Unattended-Upgrade \"1\";\n"
    }
  ]
  runcmd = [
    ["install", "-d", "-m", "0755", "-o", "root", "-g", "root", "/opt/somewhere/releases"],
    ["install", "-d", "-m", "0750", "-o", "root", "-g", "somewhere", "/etc/somewhere"],
    ["systemctl", "restart", "ssh"],
    ["systemctl", "restart", "systemd-journald"]
  ]
})}
