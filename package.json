{
  "name": "group-planning",
  "version": "0.0.0",
  "private": true,
  "description": "Somewhere: shared planning for meetups and trips with friends",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "openspec": "node scripts/openspec.mjs",
    "agent:setup": "node scripts/openspec.mjs init --tools codex --profile custom --no-animation",
    "agent:update": "node scripts/openspec.mjs update",
    "agent:check": "node scripts/check-agent-setup.mjs",
    "api:lint": "redocly lint --config contracts/redocly.yaml contracts/openapi.yaml",
    "api:check": "npm run api:lint && node scripts/check-api-contract.mjs",
    "api:test": "npm run api:lint && node scripts/test-api-contract.mjs",
    "web:dev": "npm run dev --workspace @somewhere/web",
    "web:check": "npm run check --workspace @somewhere/web",
    "web:build": "npm run build --workspace @somewhere/web",
    "web:test:e2e": "npm run test:e2e --workspace @somewhere/web",
    "web:demo": "npm run demo --workspace @somewhere/web"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.3",
    "@redocly/cli": "2.65.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  },
  "workspaces": [
    "frontend/web"
  ]
}
