[Unit]
Description=somewhere API and background tasks
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=somewhere
Group=somewhere
WorkingDirectory=/opt/somewhere/backend/current
EnvironmentFile=/etc/somewhere/application.env
ExecStart=/opt/somewhere/backend/current/somewhere-api
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
