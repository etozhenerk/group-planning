* text=auto
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh text eol=lf

# QA evidence is hashed as raw bytes. Preserve tool output, including CRLF and
# whitespace in logs, traces and embedded source excerpts.
openspec/changes/*/qa/** -text -whitespace
openspec/changes/*/assets/verification/** -text -whitespace

# Approved mobile mockups, preparation evidence and planning preimages retain
# their exact bytes/hashes; source snapshots are not reformatted during commit.
openspec/changes/mobile-mvp-design-refresh/assets/** -text -whitespace
openspec/changes/mobile-mvp-design-refresh/planning-history/** -text -whitespace
openspec/changes/mobile-mvp-design-refresh/preparation/publication-history/** -text -whitespace
openspec/changes/mobile-mvp-design-refresh/preparation/references/** -text -whitespace
openspec/changes/mobile-mvp-design-refresh/preparation/reference-check/** -text -whitespace
openspec/changes/mobile-mvp-design-refresh/preparation/selector-check/** -text -whitespace
openspec/changes/mobile-mvp-design-refresh/preparation/checks/** -text -whitespace
openspec/changes/mobile-mvp-design-refresh/preparation/baseline/** -text -whitespace
openspec/changes/mobile-mvp-design-refresh/copy-review.md -text -whitespace
openspec/changes/meeting-place-picker/handoff/** -text -whitespace
