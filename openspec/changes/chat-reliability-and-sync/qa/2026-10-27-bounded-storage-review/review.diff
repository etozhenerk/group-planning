diff --git a/backend/internal/storage/postgres/feed_plan_test.go b/backend/internal/storage/postgres/feed_plan_test.go
new file mode 100644
index 0000000..5832bd0
--- /dev/null
+++ b/backend/internal/storage/postgres/feed_plan_test.go
@@ -0,0 +1,108 @@
+package postgres
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/etozhenerk/group-planning/backend/internal/meetings"
+)
+
+type feedPlan struct {
+	NodeType     string     `json:"Node Type"`
+	RelationName string     `json:"Relation Name"`
+	ActualRows   float64    `json:"Actual Rows"`
+	ActualLoops  float64    `json:"Actual Loops"`
+	RowsRemoved  float64    `json:"Rows Removed by Filter"`
+	Plans        []feedPlan `json:"Plans"`
+}
+
+// This is an opt-in fixture against somewhere_integration, never a local DB or
+// production. It checks the actual production query plans at all three planned
+// history sizes. Timings are observations, not a portable latency benchmark.
+func TestFeedBoundedQueryPlansIntegration(t *testing.T) {
+	db := integrationDB(t)
+	for _, count := range []int{1000, 10000, 100000} {
+		t.Run(strconv.Itoa(count), func(t *testing.T) {
+			id := fmt.Sprintf("bounded-plan-%x", randBytes(12))
+			t.Cleanup(func() {
+				if err := db.Meetings().Update(context.Background(), func(w meetings.Writer) error { return w.DeleteMeeting(id) }); err != nil {
+					t.Error("fixture cleanup", err)
+				}
+			})
+			err := db.Meetings().Update(t.Context(), func(w meetings.Writer) error {
+				if err := w.SaveMeeting(meetings.Meeting{ID: id}); err != nil {
+					return err
+				}
+
+				_, err := w.(*transaction).exec(`INSERT INTO feed_entries(id,meeting_id,sequence,actor_id,client_request_id,document)
+    SELECT $1||'-'||n,$1,n,'actor',n::text,jsonb_build_object('ID',$1||'-'||n,'MeetingID',$1,'Sequence',n,'ActorID','actor','ClientRequestID',n::text,'Kind','message','Payload',jsonb_build_object('text','fixture'))
+    FROM generate_series(1,$2::int) AS n`, id, count)
+
+				return err
+			})
+			if err != nil {
+				t.Fatal("seed bounded plan fixture", err)
+			}
+
+			if _, err := db.pool.Exec(t.Context(), "ANALYZE feed_entries"); err != nil {
+				t.Fatal("analyze isolated fixture", err)
+			}
+
+			cases := []struct {
+				name, sql string
+				args      []any
+				budget    float64
+			}{
+				{"initial", feedInitialSQL, []any{id, 51}, 51},
+				{"after", feedAfterSQL, []any{id, strconv.Itoa(count / 2), 51}, 51},
+				{"before", feedBeforeSQL, []any{id, strconv.Itoa(count / 2), 51}, 51},
+				{"empty-tail", feedAfterSQL, []any{id, strconv.Itoa(count), 51}, 51},
+				{"tail", feedTailSQL, []any{id}, 1},
+				{"entry", feedEntrySQL, []any{id, id + "-500"}, 1},
+				{"intent", feedRequestSQL, []any{id, "actor", "500"}, 1},
+			}
+			for _, c := range cases {
+				t.Run(c.name, func(t *testing.T) {
+					var raw []byte
+					if err := db.pool.QueryRow(t.Context(), "EXPLAIN (ANALYZE, BUFFERS, FORMAT JSON) "+c.sql, c.args...).Scan(&raw); err != nil {
+						t.Fatal("explain", err)
+					}
+
+					var plans []struct {
+						Plan          feedPlan
+						PlanningTime  float64 `json:"Planning Time"`
+						ExecutionTime float64 `json:"Execution Time"`
+					}
+					if err := json.Unmarshal(raw, &plans); err != nil || len(plans) != 1 {
+						t.Fatal("invalid query plan", err)
+					}
+
+					feedScans := 0
+					var inspect func(feedPlan)
+					inspect = func(node feedPlan) {
+						if node.RelationName == "feed_entries" {
+							feedScans++
+							if !strings.Contains(node.NodeType, "Index") || node.ActualRows*node.ActualLoops > c.budget || node.RowsRemoved > 0 {
+								t.Errorf("unbounded feed scan: %+v", node)
+							}
+						}
+
+						for _, child := range node.Plans {
+							inspect(child)
+						}
+					}
+					inspect(plans[0].Plan)
+					if feedScans == 0 {
+						t.Fatal("plan did not inspect feed index")
+					}
+
+					t.Logf("history=%d query=%s planning_ms=%.3f execution_ms=%.3f feed_scans=%d budget_rows=%.0f", count, c.name, plans[0].PlanningTime, plans[0].ExecutionTime, feedScans, c.budget)
+				})
+			}
+		})
+	}
+}
diff --git a/backend/internal/storage/postgres/feed_window.go b/backend/internal/storage/postgres/feed_window.go
new file mode 100644
index 0000000..8eeb94d
--- /dev/null
+++ b/backend/internal/storage/postgres/feed_window.go
@@ -0,0 +1,89 @@
+package postgres
+
+import (
+	"slices"
+	"strconv"
+
+	"github.com/etozhenerk/group-planning/backend/internal/meetings"
+)
+
+const (
+	feedInitialSQL = `SELECT document FROM feed_entries WHERE meeting_id=$1 ORDER BY sequence DESC LIMIT $2`
+	feedAfterSQL   = `SELECT document FROM feed_entries WHERE meeting_id=$1 AND sequence>$2::text::numeric ORDER BY sequence ASC LIMIT $3`
+	feedBeforeSQL  = `SELECT document FROM feed_entries WHERE meeting_id=$1 AND sequence<$2::text::numeric ORDER BY sequence DESC LIMIT $3`
+	feedTailSQL    = `SELECT coalesce((SELECT sequence FROM feed_entries WHERE meeting_id=$1 ORDER BY sequence DESC LIMIT 1),0)::text`
+	feedEntrySQL   = `SELECT document FROM feed_entries WHERE meeting_id=$1 AND id=$2`
+	feedRequestSQL = `SELECT document FROM feed_entries WHERE meeting_id=$1 AND actor_id=$2 AND client_request_id=$3 AND client_request_id<>''`
+)
+
+func (tx *transaction) FeedWindow(id string, query meetings.FeedQuery) (meetings.FeedWindow, error) {
+	if query.Limit < 1 || query.Limit > 100 || (query.After != nil && query.Before != nil) {
+		return meetings.FeedWindow{}, meetings.ErrInvalidRecord
+	}
+
+	if _, err := tx.Meeting(id); err != nil {
+		return meetings.FeedWindow{}, err
+	}
+
+	latest, err := tx.feedTail(id)
+	if err != nil {
+		return meetings.FeedWindow{}, err
+	}
+
+	sql := feedInitialSQL
+	args := []any{id, query.Limit + 1}
+	if query.After != nil {
+		sql = feedAfterSQL
+		args = []any{id, strconv.FormatUint(*query.After, 10), query.Limit + 1}
+	} else if query.Before != nil {
+		sql = feedBeforeSQL
+		args = []any{id, strconv.FormatUint(*query.Before, 10), query.Limit + 1}
+	}
+
+	entries, err := many[meetings.FeedEntry](tx, sql, args...)
+	if err != nil {
+		return meetings.FeedWindow{}, err
+	}
+
+	more := len(entries) > query.Limit
+	if more {
+		entries = entries[:query.Limit]
+	}
+
+	if query.After == nil {
+		slices.Reverse(entries)
+	}
+
+	return meetings.FeedWindow{Entries: entries, LatestSequence: latest, HasMore: more}, nil
+}
+
+func (tx *transaction) feedTail(id string) (uint64, error) {
+	tx.mu.Lock()
+	defer tx.mu.Unlock()
+	if err := tx.check(false); err != nil {
+		return 0, err
+	}
+
+	var raw string
+	err := tx.tx.QueryRow(tx.ctx, feedTailSQL, id).Scan(&raw)
+	if err != nil {
+		tx.err = storageError(err)
+		return 0, tx.err
+	}
+
+	sequence, err := strconv.ParseUint(raw, 10, 64)
+	if err != nil {
+		tx.err = ErrUnavailable
+		return 0, tx.err
+	}
+
+	return sequence, nil
+}
+
+func (tx *transaction) FeedEntry(meetingID, entryID string) (meetings.FeedEntry, error) {
+	return one[meetings.FeedEntry](tx, feedEntrySQL, meetingID, entryID)
+}
+
+func (tx *transaction) MessageByRequest(meetingID, actorID, requestID string) (meetings.FeedEntry, error) {
+	return one[meetings.FeedEntry](tx, feedRequestSQL, meetingID, actorID, requestID)
+}
diff --git a/backend/internal/storage/postgres/feed_window_test.go b/backend/internal/storage/postgres/feed_window_test.go
new file mode 100644
index 0000000..f0784e8
--- /dev/null
+++ b/backend/internal/storage/postgres/feed_window_test.go
@@ -0,0 +1,227 @@
+package postgres
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"math"
+	"reflect"
+	"strconv"
+	"testing"
+
+	"github.com/etozhenerk/group-planning/backend/internal/meetings"
+)
+
+func TestFeedWindowIntegration(t *testing.T) {
+	db := integrationDB(t)
+	id := fmt.Sprintf("bounded-%x", randBytes(12))
+	store := db.Meetings()
+	t.Cleanup(func() {
+		if err := store.Update(context.Background(), func(w meetings.Writer) error { return w.DeleteMeeting(id) }); err != nil {
+			t.Error("fixture cleanup", err)
+		}
+	})
+	positions := []uint64{1, 3, 9, math.MaxInt64 + 1, math.MaxUint64}
+	err := store.Update(t.Context(), func(w meetings.Writer) error {
+		if err := w.SaveMeeting(meetings.Meeting{ID: id}); err != nil {
+			return err
+		}
+
+		// Insert sparse positions directly in this isolated test database. The API
+		// cannot generate MaxUint64 entries merely to test its numeric boundary.
+		for i, pos := range positions {
+			value := meetings.FeedEntry{ID: fmt.Sprintf("%s-%d", id, i), MeetingID: id, Sequence: pos, ActorID: "actor", ClientRequestID: fmt.Sprint(i), Kind: "message", Payload: []byte(`{"text":"original"}`)}
+			if err := w.(*transaction).save(value, `INSERT INTO feed_entries(id,meeting_id,sequence,actor_id,client_request_id,document) VALUES($1,$2,$3::text::numeric,$4,$5,$6)`, value.ID, id, strconv.FormatUint(pos, 10), value.ActorID, value.ClientRequestID); err != nil {
+				return err
+			}
+		}
+
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	p := func(v uint64) *uint64 { return &v }
+	cases := []struct {
+		name  string
+		query meetings.FeedQuery
+		want  []uint64
+		more  bool
+	}{
+		{"initial", meetings.FeedQuery{Limit: 2}, []uint64{math.MaxInt64 + 1, math.MaxUint64}, true},
+		{"after-zero", meetings.FeedQuery{Limit: 2, After: p(0)}, []uint64{1, 3}, true},
+		{"after-gap", meetings.FeedQuery{Limit: 2, After: p(4)}, []uint64{9, math.MaxInt64 + 1}, true},
+		{"after-high", meetings.FeedQuery{Limit: 2, After: p(math.MaxInt64 + 1)}, []uint64{math.MaxUint64}, false},
+		{"after-max", meetings.FeedQuery{Limit: 2, After: p(math.MaxUint64)}, []uint64{}, false},
+		{"before-max", meetings.FeedQuery{Limit: 2, Before: p(math.MaxUint64)}, []uint64{9, math.MaxInt64 + 1}, true},
+		{"before-gap", meetings.FeedQuery{Limit: 2, Before: p(8)}, []uint64{1, 3}, false},
+		{"before-zero", meetings.FeedQuery{Limit: 2, Before: p(0)}, []uint64{}, false},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			err := store.View(t.Context(), func(r meetings.Reader) error {
+				page, err := r.FeedWindow(id, c.query)
+				if err != nil {
+					return err
+				}
+
+				got := []uint64{}
+				for _, item := range page.Entries {
+					got = append(got, item.Sequence)
+				}
+
+				if !reflect.DeepEqual(got, c.want) || page.HasMore != c.more || page.LatestSequence != math.MaxUint64 {
+					t.Fatalf("page=%+v positions=%v", page, got)
+				}
+
+				return nil
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+
+	err = store.View(t.Context(), func(r meetings.Reader) error {
+		first, err := r.FeedEntry(id, id+"-0")
+		if err != nil {
+			return err
+		}
+
+		first.Payload[0] = '!'
+		again, err := r.MessageByRequest(id, "actor", "0")
+		if err != nil {
+			return err
+		}
+
+		if first.ID != again.ID || string(again.Payload) != `{"text":"original"}` {
+			t.Fatal("lookup copy")
+		}
+
+		for _, lookup := range []func() error{
+			func() error { _, err := r.FeedEntry(id+"-other", first.ID); return err },
+			func() error { _, err := r.MessageByRequest(id, "other", "0"); return err },
+			func() error { _, err := r.MessageByRequest(id, "actor", ""); return err },
+		} {
+			if err := lookup(); !errors.Is(err, meetings.ErrNotFound) {
+				t.Fatal("lookup scope", err)
+			}
+		}
+
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	err = store.Update(t.Context(), func(w meetings.Writer) error {
+		_, err := w.AppendEntry(meetings.FeedEntry{ID: id + "overflow", MeetingID: id, Payload: []byte(`{}`)})
+		return err
+	})
+	if !errors.Is(err, meetings.ErrInvalidRecord) {
+		t.Fatal("sequence overflow", err)
+	}
+}
+
+func TestFeedWindowSnapshotRollbackIntegration(t *testing.T) {
+	db := integrationDB(t)
+	id := fmt.Sprintf("bounded-snapshot-%x", randBytes(12))
+	store := db.Meetings()
+	t.Cleanup(func() {
+		if err := store.Update(context.Background(), func(w meetings.Writer) error { return w.DeleteMeeting(id) }); err != nil {
+			t.Error("fixture cleanup", err)
+		}
+	})
+	if err := store.Update(t.Context(), func(w meetings.Writer) error { return w.SaveMeeting(meetings.Meeting{ID: id}) }); err != nil {
+		t.Fatal(err)
+	}
+
+	value := meetings.FeedEntry{ID: id + "-entry", MeetingID: id, ActorID: "actor", ClientRequestID: "request", Payload: []byte(`{}`)}
+	aborted := errors.New("abort")
+	err := store.Update(t.Context(), func(w meetings.Writer) error {
+		if _, err := w.AppendEntry(value); err != nil {
+			return err
+		}
+
+		return aborted
+	})
+	if !errors.Is(err, aborted) {
+		t.Fatal(err)
+	}
+
+	var retained meetings.Reader
+	err = store.View(t.Context(), func(r meetings.Reader) error {
+		retained = r
+		empty, err := r.FeedWindow(id, meetings.FeedQuery{Limit: 1})
+		if err != nil {
+			return err
+		}
+
+		if empty.Entries == nil || len(empty.Entries) != 0 || empty.HasMore || empty.LatestSequence != 0 {
+			t.Fatal("empty after rollback", empty)
+		}
+
+		if _, err := r.FeedEntry(id, value.ID); !errors.Is(err, meetings.ErrNotFound) {
+			t.Fatal("rolled back ID", err)
+		}
+
+		if _, err := r.MessageByRequest(id, "actor", "request"); !errors.Is(err, meetings.ErrNotFound) {
+			t.Fatal("rolled back intent", err)
+		}
+
+		done := make(chan error, 1)
+		go func() {
+			done <- store.Update(t.Context(), func(w meetings.Writer) error { _, err := w.AppendEntry(value); return err })
+		}()
+		if err := <-done; err != nil {
+			return err
+		}
+
+		page, err := r.FeedWindow(id, meetings.FeedQuery{Limit: 1})
+		if err != nil {
+			return err
+		}
+
+		if len(page.Entries) != 0 || page.LatestSequence != 0 {
+			t.Fatal("tail and page escaped snapshot", page)
+		}
+
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if _, err := retained.FeedWindow(id, meetings.FeedQuery{Limit: 1}); !errors.Is(err, meetings.ErrTransactionClosed) {
+		t.Fatal("retained window", err)
+	}
+
+	if _, err := retained.FeedEntry(id, value.ID); !errors.Is(err, meetings.ErrTransactionClosed) {
+		t.Fatal("retained lookup", err)
+	}
+
+	ctx, cancel := context.WithCancel(t.Context())
+	err = store.View(ctx, func(r meetings.Reader) error {
+		cancel()
+		for _, lookup := range []func() error{func() error { _, err := r.FeedWindow(id, meetings.FeedQuery{Limit: 1}); return err }, func() error { _, err := r.FeedEntry(id, value.ID); return err }, func() error { _, err := r.MessageByRequest(id, "actor", "request"); return err }} {
+			if err := lookup(); !errors.Is(err, context.Canceled) {
+				t.Fatal("cancelled lookup", err)
+			}
+		}
+
+		return nil
+	})
+	if !errors.Is(err, context.Canceled) {
+		t.Fatal("cancelled view", err)
+	}
+}
+
+func TestFeedStorageCancellationErrors(t *testing.T) {
+	for _, cause := range []error{context.Canceled, context.DeadlineExceeded} {
+		wrapped := fmt.Errorf("query: %w", cause)
+		if !errors.Is(storageError(wrapped), cause) {
+			t.Fatal("lost cancellation cause")
+		}
+	}
+}
