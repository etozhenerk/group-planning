{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "ES2022.Intl"],
    "strict": true,
    "noEmit": true,
    "paths": { "@prototype/*": ["./src/*"] },
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
