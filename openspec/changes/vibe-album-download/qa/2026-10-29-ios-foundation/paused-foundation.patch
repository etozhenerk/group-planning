--- /dev/null
+++ b/frontend/ios/Somewhere/Data/API/APIClient+Download.swift
@@ -0,0 +1,28 @@
+import Foundation
+
+extension APIClient {
+    func download(
+        _ request: APIRequest, to fileURL: URL, expectedBytes: Int, contentType: String,
+        credential: StoredSession, using transport: any HTTPFileTransport
+    ) async throws {
+        guard request.method == .get, request.body == nil, request.expectedStatus == 200,
+            request.meetingID != nil
+        else { throw ClientFailure.invalidRequest }
+        var wire = URLRequest(url: try origin.url(for: request))
+        wire.httpMethod = "GET"
+        wire.cachePolicy = .reloadIgnoringLocalCacheData
+        wire.httpShouldHandleCookies = false
+        wire.setValue(contentType, forHTTPHeaderField: "Accept")
+        wire.setValue("Bearer " + credential.token, forHTTPHeaderField: "Authorization")
+        do {
+            try await transport.download(
+                wire, to: fileURL, expectedBytes: expectedBytes, contentType: contentType)
+            try Task.checkCancellation()
+        } catch {
+            if Task.isCancelled || (error as? URLError)?.code == .cancelled {
+                throw CancellationError()
+            }
+            throw ClientFailure.sanitized(error)
+        }
+    }
+}
diff --git a/frontend/ios/Somewhere/Data/API/AlbumFileBuffer.swift b/frontend/ios/Somewhere/Data/API/AlbumFileBuffer.swift
new file mode 100644
index 00000000..20d0a193
--- /dev/null
+++ b/frontend/ios/Somewhere/Data/API/AlbumFileBuffer.swift
@@ -0,0 +1,39 @@
+import Foundation
+
+final class AlbumFileBuffer {
+    static let chunkBytes = 64 * 1024
+    private let handle: FileHandle
+    private let expectedBytes: Int
+    private var received = 0
+    private var chunk = Data()
+
+    init(fileURL: URL, expectedBytes: Int) throws {
+        guard (1...AlbumPhoto.maximumPhotoBytes).contains(expectedBytes) else {
+            throw ClientFailure.invalidRequest
+        }
+        self.expectedBytes = expectedBytes
+        handle = try FileHandle(forWritingTo: fileURL)
+        try handle.truncate(atOffset: 0)
+        chunk.reserveCapacity(Self.chunkBytes)
+    }
+
+    func append(_ byte: UInt8) throws {
+        guard received < expectedBytes else { throw ClientFailure.invalidResponse }
+        received += 1
+        chunk.append(byte)
+        if chunk.count == Self.chunkBytes {
+            try Task.checkCancellation()
+            try handle.write(contentsOf: chunk)
+            chunk.removeAll(keepingCapacity: true)
+        }
+    }
+
+    func finish() throws {
+        try Task.checkCancellation()
+        guard received == expectedBytes else { throw ClientFailure.invalidResponse }
+        try handle.write(contentsOf: chunk)
+        chunk.removeAll(keepingCapacity: true)
+    }
+
+    func close() throws { try handle.close() }
+}
