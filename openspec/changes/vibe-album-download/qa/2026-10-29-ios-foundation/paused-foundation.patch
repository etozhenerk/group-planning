+import Foundation
+
+struct MemorySnapshot: Decodable, Sendable {
+    let photos: [MeetingMedia]
+
+    enum CodingKeys: String, CodingKey {
+        case photos
+        case nextCursor = "next_cursor"
+    }
+
+    init(photos: [MeetingMedia]) { self.photos = photos }
+
+    init(from decoder: any Decoder) throws {
+        let values = try decoder.container(keyedBy: CodingKeys.self)
+        guard try values.decodeNil(forKey: .nextCursor) else {
+            throw AlbumSaveFailure.invalidSnapshot
+        }
+        photos = try values.decode([MeetingMedia].self, forKey: .photos)
+    }
+}
diff --git a/frontend/ios/Somewhere/Data/API/URLSessionFileTransport.swift b/frontend/ios/Somewhere/Data/API/URLSessionFileTransport.swift
new file mode 100644
index 00000000..602f1c3e
--- /dev/null
+++ b/frontend/ios/Somewhere/Data/API/URLSessionFileTransport.swift
@@ -0,0 +1,43 @@
+import Foundation
+
+actor URLSessionFileTransport: HTTPFileTransport {
+    private let session: URLSession
+
+    init(configuration: URLSessionConfiguration = .ephemeral) {
+        configuration.httpShouldSetCookies = false
+        configuration.httpCookieStorage = nil
+        configuration.urlCache = nil
+        configuration.requestCachePolicy = .reloadIgnoringLocalCacheData
+        configuration.timeoutIntervalForRequest = 30
+        configuration.timeoutIntervalForResource = 60
+        session = URLSession(
+            configuration: configuration, delegate: NoRedirectDelegate(), delegateQueue: nil)
+    }
+
+    deinit { session.invalidateAndCancel() }
+
+    func download(
+        _ request: URLRequest, to fileURL: URL, expectedBytes: Int, contentType: String
+    ) async throws {
+        guard request.url?.scheme == "https", fileURL.isFileURL,
+            (1...AlbumPhoto.maximumPhotoBytes).contains(expectedBytes)
+        else { throw ClientFailure.invalidRequest }
+        try Task.checkCancellation()
+        let (bytes, response) = try await session.bytes(for: request)
+        defer { bytes.task.cancel() }
+        guard let http = response as? HTTPURLResponse else { throw ClientFailure.invalidResponse }
+        guard http.statusCode == 200 else { throw ClientFailure.http(http.statusCode, nil) }
+        guard http.url == request.url, http.mimeType?.lowercased() == contentType,
+            http.expectedContentLength == -1 || http.expectedContentLength == Int64(expectedBytes)
+        else { throw ClientFailure.invalidResponse }
+        let writer = try AlbumFileBuffer(fileURL: fileURL, expectedBytes: expectedBytes)
+        do {
+            for try await byte in bytes { try writer.append(byte) }
+            try writer.finish()
+        } catch {
+            do { try writer.close() } catch { throw AlbumSaveFailure.storage }
+            throw error
+        }
+        try writer.close()
+    }
+}
diff --git a/frontend/ios/Somewhere/Data/Album/AlbumDownloadService.swift b/frontend/ios/Somewhere/Data/Album/AlbumDownloadService.swift
new file mode 100644
index 00000000..35348f1c
--- /dev/null
+++ b/frontend/ios/Somewhere/Data/Album/AlbumDownloadService.swift
@@ -0,0 +1,70 @@
+import Foundation
+
+@MainActor
+final class AlbumDownloadService {
+    private static var active = false
+    private let source: any AlbumPhotoSource
+    private let library: any AlbumPhotoLibrary
+    private let files: AlbumTemporaryFiles
+    private var completed: (operationID: UUID, count: Int)?
+
+    init(
+        source: any AlbumPhotoSource, library: any AlbumPhotoLibrary,
+        files: AlbumTemporaryFiles = AlbumTemporaryFiles()
+    ) {
+        self.source = source
+        self.library = library
+        self.files = files
+    }
+
+    func save(operationID: UUID) async throws -> Int {
+        try checkPreparation()
+        if let completed, completed.operationID == operationID { return completed.count }
+        guard !Self.active else { throw AlbumSaveFailure.busy }
+        Self.active = true
+        defer { Self.active = false }
+        try await library.requireAddPermission()
+        try checkPreparation()
+        let snapshot = try await source.snapshot()
+        try checkPreparation()
+        let photos = try AlbumPhoto.validate(snapshot, meetingID: source.meetingID)
+        let directory = try await files.create()
+        var savedCount = 0
+        do {
+            try checkPreparation()
+            var prepared: [AlbumPreparedPhoto] = []
+            prepared.reserveCapacity(photos.count)
+            for photo in photos {
+                let file = try await files.prepare(photo, in: directory)
+                try checkPreparation()
+                try await source.download(photo, to: file)
+                try checkPreparation()
+                let item = AlbumPreparedPhoto(photo: photo, fileURL: file)
+                try await files.validate(item)
+                try checkPreparation()
+                prepared.append(item)
+            }
+            try await source.verifyAccess()
+            try checkPreparation()
+            // The PhotoKit transaction owns the outcome from this point. Cancellation or
+            // revocation cannot undo a submitted save; keep files until its completion.
+            try await library.save(prepared)
+            savedCount = prepared.count
+            completed = (operationID, savedCount)
+        } catch {
+            do { try await files.remove(directory) } catch {
+                throw AlbumSaveFailure.cleanup(savedCount: 0)
+            }
+            throw error
+        }
+        do { try await files.remove(directory) } catch {
+            throw AlbumSaveFailure.cleanup(savedCount: savedCount)
+        }
+        return savedCount
+    }
+
+    private func checkPreparation() throws {
+        try Task.checkCancellation()
+        try source.checkAccess()
+    }
+}
diff --git a/frontend/ios/Somewhere/Data/Album/AlbumPhoto.swift b/frontend/ios/Somewhere/Data/Album/AlbumPhoto.swift
new file mode 100644
index 00000000..9ce08db9
--- /dev/null
+++ b/frontend/ios/Somewhere/Data/Album/AlbumPhoto.swift
@@ -0,0 +1,34 @@
+import Foundation
+
+struct AlbumPhoto: Equatable, Sendable {
+    static let maximumPhotoBytes = 10 * 1024 * 1024
+    static let maximumAlbumBytes = 1024 * 1024 * 1024
+    let id: UUID
+    let contentType: String
+    let sizeBytes: Int
+    let fileName: String
+
+    static func validate(_ snapshot: MemorySnapshot, meetingID: UUID) throws -> [AlbumPhoto] {
+        guard !snapshot.photos.isEmpty else { throw AlbumSaveFailure.empty }
+        var seen = Set<UUID>()
+        var total = 0
+        return try snapshot.photos.map { media in
+            let extensions = ["image/jpeg": "jpg", "image/png": "png", "image/webp": "webp"]
+            guard media.meetingID == meetingID, media.purpose == "memory",
+                media.kind == "photo", media.status == "published",
+                seen.insert(media.id).inserted, let suffix = extensions[media.contentType],
+                (1...maximumPhotoBytes).contains(media.sizeBytes),
+                media.sizeBytes <= maximumAlbumBytes - total
+            else { throw AlbumSaveFailure.invalidSnapshot }
+            total += media.sizeBytes
+            return AlbumPhoto(
+                id: media.id, contentType: media.contentType, sizeBytes: media.sizeBytes,
+                fileName: media.id.uuidString.lowercased() + "." + suffix)
+        }
+    }
+}
+
+struct AlbumPreparedPhoto: Sendable {
+    let photo: AlbumPhoto
+    let fileURL: URL
+}
