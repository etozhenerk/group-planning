    {
      "id": "TC-SUPPORT-C47A0ACC",
      "title": "Доступная форма обращения: Обращение без контакта",
      "source": {
        "path": "openspec/changes/meeting-experience-refresh/specs/support-feedback/spec.md",
        "requirement": "Доступная форма обращения",
        "scenario": "Обращение без контакта",
        "sha256": "d7d7744f3a74c285de0859ccbf12ee29162642efef498b89c6cb72e1cb51798d"
      },
      "steps": [
        {
          "action": "Открыть форму из профиля или помощи; в desktop web дополнительно проверить вход из футера онбординга и боковой навигации.",
          "expected": "Форма открывается с темой, описанием, выбранным экраном и необязательными почтой, скриншотом, диагностикой."
        },
        {
          "action": "Открыть сведения о встрече, а на iOS/Android — полный экран мобильного онбординга.",
          "expected": "В этих местах нет отдельного входа в обращение; онбординг не перекрыт сервисной кнопкой."
        },
        {
          "action": "Вернуться в форму, выбрать тему и экран, заполнить описание «Не открывается встреча после нажатия», оставить почту/скриншот пустыми и диагностику выключенной; отправить.",
          "expected": "Отсутствие контакта не блокирует отправку. До принятия сервером успех и номер не показываются."
        },
        {
          "action": "Подтвердить принятие в fixture, дождаться ответа и сверить номер с созданной записью.",
          "expected": "Показан именно подтверждённый номер; создано одно обращение без почты, скриншота и диагностических сведений."
        }
      ]
    },
    {
      "id": "TC-SUPPORT-B8F9FF7E",
      "title": "Доступная форма обращения: Недостаточное описание",
      "source": {
        "path": "openspec/changes/meeting-experience-refresh/specs/support-feedback/spec.md",
        "requirement": "Доступная форма обращения",
        "scenario": "Недостаточное описание",
        "sha256": "010c6896c4a5723333129493cd6aa9ecc675f472ca1636546a0eaad9da6e66e1"
      },
      "steps": [
        {
          "action": "Выбрать тему/экран; ввести описание из 9 символов с крайними пробелами и нажать отправку.",
          "expected": "Ошибка показана у описания; введённое, тема и экран сохранены, успеха нет."
        },
        {
          "action": "Заменить описание строкой из 3001 символа и повторить отправку.",
          "expected": "Показана ошибка ограничения; значения сохранены, обращение не принято."
        },
        {
          "action": "На отдельных чистых формах проверить строки длиной 10 и 3000 символов после trim, не указывая почту.",
          "expected": "Граничная длина допустима; сервер подтверждает каждую отправку своим номером."
        },
        {
          "action": "Открыть сведения встречи и мобильный онбординг соответствующей платформы.",
          "expected": "Недоступный по требованиям вход в обращение не возвращён туда ради теста; форма по-прежнему доступна из профиля."
        }
      ]
    },
