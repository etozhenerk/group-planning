# Шаблон для выбранного origin; Go не загружает этот файл автоматически.
# Скопируй в .env.yandex.local (игнорируется Git), заполни Client ID и секрет.
# Затем из backend/: set -a; . ./.env.yandex.local; set +a; go run ./cmd/server
# Не запускай шаблон без заполненных значений и настроенного HTTPS proxy.
SOMEWHERE_HTTP_ADDR=127.0.0.1:8080
SOMEWHERE_STORAGE=memory
SOMEWHERE_AUTH_ENABLED=true
SOMEWHERE_PUBLIC_ORIGIN=https://somewhere.ru
SOMEWHERE_WEB_ORIGIN=https://somewhere.ru
SOMEWHERE_WEB_DIST=../frontend/web/dist
SOMEWHERE_YANDEX_CLIENT_ID=''
SOMEWHERE_YANDEX_CLIENT_SECRET=''
SOMEWHERE_IOS_AUTH_CALLBACK=group-planning-ios://auth/callback
SOMEWHERE_ANDROID_AUTH_CALLBACK=group-planning-android://auth/callback
SOMEWHERE_SESSION_TTL=720h
