# go run does not load .env automatically; export settings in your shell.
SOMEWHERE_HTTP_ADDR=127.0.0.1:8080
SOMEWHERE_STORAGE=memory
# Production: SOMEWHERE_STORAGE=postgres; DSN stays outside Git.
# SOMEWHERE_DATABASE_URL="host=/var/run/postgresql dbname=somewhere user=somewhere sslmode=disable"
SOMEWHERE_SHUTDOWN_TIMEOUT=5s

# OAuth is disabled until a registered client and a shared HTTPS origin exist.
SOMEWHERE_AUTH_ENABLED=false
# Uncomment the following settings together with AUTH_ENABLED=true.
# SOMEWHERE_PUBLIC_ORIGIN=https://somewhere.example
# SOMEWHERE_YANDEX_CLIENT_ID=your-registered-client-id
# SOMEWHERE_YANDEX_CLIENT_SECRET=configure-outside-git
# SOMEWHERE_IOS_AUTH_CALLBACK=group-planning-ios://auth/callback
# SOMEWHERE_ANDROID_AUTH_CALLBACK=group-planning-android://auth/callback
# SOMEWHERE_SESSION_TTL=720h

# Optional built web and invitation metadata; independent of OAuth.
# Build first: npm run web:build from repository root.
# SOMEWHERE_WEB_DIST=../frontend/web/dist
# SOMEWHERE_WEB_ORIGIN=https://somewhere.example

# Публичные ассоциации мобильных приложений: backend/docs/app-links.md.
# App ID prefix берётся из подписанного приложения, не угадывается по Team ID.
# SOMEWHERE_IOS_APP_IDS=ABCDEFGHIJ.dev.groupplanning.ios
# Android package и SHA-256 задаются вместе; несколько отпечатков — через запятую.
# SOMEWHERE_ANDROID_APP_ID=dev.groupplanning.android
# SOMEWHERE_ANDROID_SHA256_CERT_FINGERPRINTS=SHA256_COLON_SEPARATED_FROM_INSTALLED_SIGNING_CERTIFICATE

# In-process meeting transitions; shares the selected store with the API.
# SOMEWHERE_TRANSITION_POLL_INTERVAL=1s
# SOMEWHERE_TRANSITION_LEASE=30s
# SOMEWHERE_TRANSITION_MAX_ATTEMPTS=5
# SOMEWHERE_TRANSITION_RETRY_BASE=5s
# SOMEWHERE_TRANSITION_RETRY_MAX=5m
# SOMEWHERE_TRANSITION_BATCH_SIZE=100
# SOMEWHERE_TRANSITION_RECONCILE_INTERVAL=1m
# SOMEWHERE_TRANSITION_DELAY_THRESHOLD=1m
# SOMEWHERE_TRANSITION_RECONCILE_STALE=5m

# Обращения: локальная очередь в памяти, без внешней доставки по умолчанию.
# Постоянный приём/сроки хранения/канал настраиваются отдельным облачным этапом.
# SOMEWHERE_SUPPORT_BOT_TOKEN=configure-outside-git
# SOMEWHERE_SUPPORT_CHAT_ID=-1000000000000

# HTTP sync выключен без стабильного ключа из 32 байтов в base64.
# Ключ сохраняется при рестартах; его значение не добавляют в Git.
SOMEWHERE_CHAT_SYNC_KEY=
